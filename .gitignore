# ---------- LaTeX ----------
# Tutti gli artefatti di compilazione finiscono in thesis/build/ (vedi latexmkrc)
thesis/build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.nav
*.snm
*.vrb
*.tmp
# Il PDF compilato NON va versionato: si rigenera. Fa eccezione la consegna
# finale, che va allegata a un tag git o a una release.
thesis/main.pdf

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- Dati e modelli ----------
# I dataset si ricreano dal codice, non si versionano (vedi data/README.md)
data/raw/*
data/processed/*
data/processed_test/*
data/processed_128/*
data/processed_test_128/*
data/external/*
!data/**/.gitkeep
!data/**/README.md
*.pt
*.pth
*.ckpt
*.h5
*.npz

# ---------- Esperimenti ----------
experiments/*
!experiments/registry.md
!experiments/giudice-stile.md
!experiments/.gitkeep
wandb/
outputs/
multirun/
lightning_logs/

# ---------- Segreti ----------
